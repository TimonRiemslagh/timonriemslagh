{
  "functions": {
    "api/mood.js": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/mood", "schedule": "0 18 * * 0" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ]
}
